{
  "name": "in-keeping",
  "version": "1.0.0",
  "private": true,
  "license": "LicenseRef-Hayden-Proprietary-1.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "bash scripts/build-verified.sh",
    "start": "vite preview --host 0.0.0.0",
    "test": "npm run build && npm run test:unit",
    "test:licensing": "node scripts/check-licensing.mjs",
    "validate:sbom": "node scripts/validate-sbom.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker && npm run typecheck:tools",
    "typecheck:app": "tsc -p tsconfig.app.json",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "lint": "bash scripts/sites-env.sh -- eslint .",
    "audit:dependencies": "npm audit --audit-level=high",
    "validate:cloudflare": "node scripts/validate-cloudflare-build.mjs",
    "verify": "npm run test:licensing && npm run lint && npm run typecheck && npm test",
    "deploy:dry-run": "bash scripts/cloudflare-deploy.sh dry-run",
    "deploy:cloudflare": "bash scripts/cloudflare-deploy.sh production",
    "deploy:preview": "bash scripts/cloudflare-deploy.sh preview",
    "release:check": "npm run verify && npm run audit:dependencies && npm run validate:cloudflare && npm run deploy:dry-run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.6",
    "globals": "17.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "displayName": "IN KEEPING"
}
