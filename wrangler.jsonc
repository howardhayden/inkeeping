{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "in-keeping",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": false
  }
}
